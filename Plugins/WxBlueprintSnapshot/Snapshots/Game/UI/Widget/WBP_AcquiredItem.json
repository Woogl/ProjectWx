	"eventGraph": [
		"void OnListItemObjectSet(UObject* ListItemObject)",
		"{",
		"    UWxViewModel_Item* AsWxViewModel_Item = Cast<UWxViewModel_Item>(ListItemObject);",
		"    if (AsWxViewModel_Item)",
		"    {",
		"        SetWxViewModel_Item(AsWxViewModel_Item);",
		"        UWidgetAnimationPlayCallbackProxy::NewPlayAnimationProxyObject(this, Appear);",
		"        auto Finished = [this]()",
		"        {",
		"            UCommonUILibrary::FindParentWidgetOfType(this);",
		"            if ((IsValid(UCommonUILibrary::FindParentWidgetOfType(this))) && (IsValid(WxViewModel_Item)))",
		"            {",
		"                UCommonUILibrary::FindParentWidgetOfType(this)->RemoveItem(WxViewModel_Item);",
		"            }",
		"        };",
		"    }",
		"}"
