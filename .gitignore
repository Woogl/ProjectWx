# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Agents (AI 하네스 — 스킬·스크립트 정본은 .agents/)
# Wiki/ (claude-obsidian vault) is intentionally versioned; its own .gitignore keeps runtime state out.
# Obsidian creates this per-user plugin list the first time a reader opens the vault.
/Wiki/.obsidian/core-plugins.json
.claude/**/*.local.json
.agents/**/*.local.json

# .claude/skills 는 .agents/skills 를 가리키는 junction 이라 추적하지 않는다.
/.claude/skills/

# Python
__pycache__/

# IDE
*.DotSettings.user
.idea/

# Temporary files
~*
