# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Claude
.claude/**/*.local.json

# IDE
*.DotSettings.user
.idea/

# GASP 데모/쇼케이스 아트 (레포에서 제외, 로컬 디스크에는 유지)
/Content/Characters/Echo/
/Content/Characters/Paragon/
/Content/Characters/UE4_Mannequin/
/Content/MetaHumans/
/Content/Locomotor/Mech/
/Content/Blueprints/RetargetedCharacters/BP_Echo.uasset
/Content/Blueprints/RetargetedCharacters/BP_Twinblast.uasset
/Content/Blueprints/RetargetedCharacters/BP_UE4_Mannequin.uasset